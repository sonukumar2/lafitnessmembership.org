---
import { site, mainNav, legalNav } from '../data/site';
const path = Astro.url.pathname;
---
<a class="skip" href="#content">Skip to content</a>
<div class="utility">
  <div class="wrap">
    <span class="links">
      {legalNav.map((l) => <a href={l.href}>{l.label}</a>)}
    </span>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={site.name + ' home'}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0f1f2e"/><circle cx="32" cy="34" r="13" fill="none" stroke="#2dd4bf" stroke-width="5"/><rect x="10" y="32" width="44" height="5" rx="2.5" fill="#2dd4bf"/></svg>
      <span>LA Fitness Membership</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Main">
      <ul>
        {mainNav.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var t = document.querySelector('.nav-toggle');
    var n = document.getElementById('nav');
    t.addEventListener('click', function () {
      var open = n.classList.toggle('open');
      t.setAttribute('aria-expanded', open);
    });
    n.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { n.classList.remove('open'); t.setAttribute('aria-expanded', 'false'); });
    });
  })();
</script>
